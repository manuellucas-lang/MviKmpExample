CREATE TABLE operaciones (
    id INTEGER NOT NULL PRIMARY KEY,
    titulo TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    imagen_url TEXT,
    tipo TEXT,
    autor TEXT,
    propia INTEGER NOT NULL DEFAULT 0,
    guardada INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM operaciones ORDER BY id DESC;

selectById:
SELECT * FROM operaciones WHERE id = ?;

insertOrReplace:
INSERT INTO operaciones(id, titulo, descripcion, imagen_url, tipo, autor, propia, guardada)
VALUES (?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    titulo = excluded.titulo,
    descripcion = excluded.descripcion,
    imagen_url = excluded.imagen_url,
    tipo = excluded.tipo,
    autor = excluded.autor;

setGuardada:
UPDATE operaciones SET guardada = ? WHERE id = ?;

setPropia:
UPDATE operaciones SET propia = ? WHERE id = ?;

deleteById:
DELETE FROM operaciones WHERE id = ?;

deleteAll:
DELETE FROM operaciones;
