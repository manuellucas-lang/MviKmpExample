CREATE TABLE posts (
    id INTEGER NOT NULL PRIMARY KEY,
    userId INTEGER NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    image_url TEXT,
    author_name TEXT,
    is_mine INTEGER NOT NULL DEFAULT 0,
    is_saved INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM posts ORDER BY id DESC;

selectById:
SELECT * FROM posts WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO posts(id, userId, title, body, image_url, author_name, is_mine, is_saved)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

setSaved:
UPDATE posts SET is_saved = ? WHERE id = ?;

deleteById:
DELETE FROM posts WHERE id = ?;

deleteAll:
DELETE FROM posts;
